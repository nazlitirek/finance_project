# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası Git'e eklenmez.

# PostgreSQL (scripts/setup_db.ps1 bu bilgilerle veritabanını oluşturur)
DATABASE_URL=postgresql+psycopg://bist_app:CHANGE_ME@localhost:5432/bist_intelligence
TEST_DATABASE_URL=postgresql+psycopg://bist_app:CHANGE_ME@localhost:5432/bist_intelligence_test

# AI sağlayıcısı: gemini veya anthropic
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com → Get API key)
# Not: ücretsiz katmanda Google gönderilen içeriği ürünlerini geliştirmek için kullanabilir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (AI_PROVIDER=anthropic ise)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# TCMB EVDS (https://evds3.tcmb.gov.tr üzerinden ücretsiz anahtar)
EVDS_API_KEY=

# Arka plan veri güncellemeleri (sadece backend çalışırken çalışır)
SCHEDULER_ENABLED=true

# Sadece bu yerel frontend adreslerine izin verilir (virgülle ayırın)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
